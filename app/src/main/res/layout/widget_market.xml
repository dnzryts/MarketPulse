<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:layout_marginBottom="4dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="● MarketPulse" android:textColor="#F3F5F6" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#9AA4AC" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:text="Open MarketPulse to load your watchlist" android:textColor="#9AA4AC" android:textSize="13sp" />
    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/row1_sym" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#F3F5F6" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/row1_price" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#F3F5F6" android:textSize="14sp" android:layout_marginEnd="10dp" />
        <TextView android:id="@+id/row1_chg" android:layout_width="72dp" android:layout_height="wrap_content"
            android:gravity="end" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/row2_sym" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#F3F5F6" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/row2_price" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#F3F5F6" android:textSize="14sp" android:layout_marginEnd="10dp" />
        <TextView android:id="@+id/row2_chg" android:layout_width="72dp" android:layout_height="wrap_content"
            android:gravity="end" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/row3_sym" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#F3F5F6" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/row3_price" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#F3F5F6" android:textSize="14sp" android:layout_marginEnd="10dp" />
        <TextView android:id="@+id/row3_chg" android:layout_width="72dp" android:layout_height="wrap_content"
            android:gravity="end" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/row4_sym" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#F3F5F6" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/row4_price" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#F3F5F6" android:textSize="14sp" android:layout_marginEnd="10dp" />
        <TextView android:id="@+id/row4_chg" android:layout_width="72dp" android:layout_height="wrap_content"
            android:gravity="end" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/row5_sym" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#F3F5F6" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/row5_price" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#F3F5F6" android:textSize="14sp" android:layout_marginEnd="10dp" />
        <TextView android:id="@+id/row5_chg" android:layout_width="72dp" android:layout_height="wrap_content"
            android:gravity="end" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
